# ── Database (PostgreSQL) ───────────────────────────────────────────
# Vercel: added automatically when you connect Prisma Postgres (Storage tab).
# Local:  run `npm run db:local`, then use the URL below.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# ── Site ────────────────────────────────────────────────────────────
# Your public URL (used for canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://jarvxit.com"

# ── Admin auth ──────────────────────────────────────────────────────
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Initial admin account (created on first seed; change the password later in /admin/settings)
ADMIN_EMAIL="admin@jarvxit.com"
ADMIN_PASSWORD=""

# ── File storage ────────────────────────────────────────────────────
# Vercel: added automatically when you connect a Blob store. Leave empty locally (uses ./storage).
BLOB_READ_WRITE_TOKEN=""

# ── Optional ────────────────────────────────────────────────────────
# Claude-powered chat assistant (falls back to a built-in FAQ bot without it)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
NEXT_PUBLIC_WHATSAPP="8801332775533"
NEXT_PUBLIC_MESSENGER_PAGE="jarvxit"
